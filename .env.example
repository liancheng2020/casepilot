# Node >= 22.13. No key is required for the explicitly labelled rule simulator.
HOST=127.0.0.1
PORT=5188
DATA_DIR=./data
AGENT_MODE=mock
# Switch AGENT_MODE to deepseek to enable real tool calling. No silent fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MAX_MODEL_REQUESTS=12
MAX_TOOL_CALLS=24
MODEL_TIMEOUT_MS=25000
# Required when HOST is not loopback. Shared demo access, NOT production auth.
WEB_ACCESS_TOKEN=
# Optional Feishu self-built bot; only private text messages are accepted.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Send "身份" to obtain your own tenant_key and open_id.
# Empty allowlist permits identity discovery ONLY, never business actions.
FEISHU_TENANT_KEY=
# Verified open_id -> local actor ID. Unknown users are rejected.
FEISHU_ACTOR_MAP={}
# The Web details link used in bot replies; no credentials in this URL.
PUBLIC_BASE_URL=http://localhost:5188
